// Prisma Schema for NEGI TUTORIALS
// Database: PostgreSQL (Neon.tech, Supabase, or local PostgreSQL compatible)

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             Int       @id @default(autoincrement())
  username       String    @unique
  email          String    @unique
  passwordHash   String    @map("password_hash")
  role           String    @default("student") // "owner", "mentor", "student"
  profilePicture String?   @map("profile_picture")
  designation    String?
  bio            String?
  streamId       Int?      @map("stream_id")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")

  // Relationships
  stream             Stream?                 @relation("MentorStream", fields: [streamId], references: [id], onDelete: SetNull)
  studentProfile     StudentProfile?
  assignedSubjects   Subject[]               @relation("MentorSubjects")
  markedAttendances  Attendance[]            @relation("MarkedByMentor")
  receivedPayments   FeePayment[]            @relation("ReceivedByMentor")
  timetableSlots     Timetable[]             @relation("MentorTimetable")
  announcements      Announcement[]          @relation("CreatedAnnouncements")
  assignedHomeworks  Homework[]              @relation("AssignedHomeworks")

  @@map("users")
}

model Stream {
  id                Int              @id @default(autoincrement())
  name              String           @unique
  code              String           @unique // PCM, PCB, COMM, ARTS
  applicableClasses String           @default("11,12") @map("applicable_classes")
  description       String?
  isActive          Boolean          @default(true) @map("is_active")

  // Relationships
  subjects          Subject[]
  students          StudentProfile[]
  mentors           User[]           @relation("MentorStream")

  @@map("streams")
}

model Subject {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  targetClass Int      @map("target_class") // 10, 11, 12
  streamId    Int?     @map("stream_id")
  monthlyFee  Float    @default(1500.0) @map("monthly_fee")
  description String?
  isActive    Boolean  @default(true) @map("is_active")

  // Relationships
  stream              Stream?          @relation(fields: [streamId], references: [id], onDelete: SetNull)
  assignedMentors     User[]           @relation("MentorSubjects")
  studentAssociations StudentSubject[]
  exams               Exam[]
  timetableSlots      Timetable[]
  homeworkItems       Homework[]
  attendances         Attendance[]

  @@map("subjects")
}

model StudentProfile {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique @map("user_id")
  enrollmentNo     String    @unique @map("enrollment_no")
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  gender           String?
  dob              DateTime?
  contactNumber    String?   @map("contact_number")
  parentName       String?   @map("parent_name")
  parentContact    String?   @map("parent_contact")
  parentEmail      String?   @map("parent_email")
  address          String?
  emergencyContact String?   @map("emergency_contact")
  targetClass      Int       @map("target_class") // 10, 11, 12
  academicYear     String    @default("2026-2027") @map("academic_year")
  streamId         Int?      @map("stream_id")
  isStreamLocked   Boolean   @default(false) @map("is_stream_locked")
  isSubjectLocked  Boolean   @default(false) @map("is_subject_locked")
  admissionDate    DateTime  @default(now()) @map("admission_date")
  notes            String?

  // Relationships
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stream           Stream?               @relation(fields: [streamId], references: [id], onDelete: SetNull)
  subjectEnrollments StudentSubject[]
  attendanceRecords  Attendance[]
  feeStructures      FeeStructure[]
  feePayments        FeePayment[]
  examMarks          ExamMark[]
  changeRequests     SubjectChangeRequest[]
  homeworkStatuses   StudentHomeworkStatus[]

  @@map("student_profiles")
}

model StudentSubject {
  id           Int            @id @default(autoincrement())
  studentId    Int            @map("student_id")
  subjectId    Int            @map("subject_id")
  enrolledDate DateTime       @default(now()) @map("enrolled_date")
  status       String         @default("Active") // Active, Dropped, Completed

  // Relationships
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject      Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId], name: "uq_student_subject")
  @@map("student_subjects")
}

model SubjectChangeRequest {
  id            Int            @id @default(autoincrement())
  studentId     Int            @map("student_id")
  requestType   String         @map("request_type") // 'Stream Change' or 'Subject Selection Change'
  details       String
  status        String         @default("Pending") // Pending, Approved, Rejected
  mentorRemarks String?        @map("mentor_remarks")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  // Relationships
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("subject_change_requests")
}

model Attendance {
  id          Int            @id @default(autoincrement())
  studentId   Int            @map("student_id")
  date        DateTime
  targetClass Int            @map("target_class")
  subjectId   Int?           @map("subject_id")
  status      String         @default("Present") // Present, Absent, Late, Excused
  remarks     String?
  markedById  Int?           @map("marked_by_id")

  // Relationships
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  markedBy    User?          @relation("MarkedByMentor", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([studentId, date, subjectId], name: "uq_student_date_subject")
  @@map("attendance")
}

model FeeStructure {
  id              Int            @id @default(autoincrement())
  studentId       Int            @map("student_id")
  academicYear    String         @default("2026-2027") @map("academic_year")
  totalAnnualFee  Float          @map("total_annual_fee")
  discountAmount  Float          @default(0.0) @map("discount_amount")
  discountReason  String?        @map("discount_reason")
  finalFee        Float          @map("final_fee")
  paidAmount      Float          @default(0.0) @map("paid_amount")
  dueAmount       Float          @map("due_amount")
  status          String         @default("Pending") // Paid, Partial, Pending, Overdue
  createdAt       DateTime       @default(now()) @map("created_at")

  // Relationships
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments        FeePayment[]

  @@map("fee_structures")
}

model FeePayment {
  id                 Int            @id @default(autoincrement())
  receiptNo          String         @unique @map("receipt_no")
  feeStructureId     Int            @map("fee_structure_id")
  studentId          Int            @map("student_id")
  amount             Float
  paymentDate        DateTime       @default(now()) @map("payment_date")
  paymentMode        String         @default("UPI") @map("payment_mode") // Cash, UPI, Net Banking, Cheque
  referenceNo        String?        @map("reference_no")
  remarks            String?
  receivedById       Int?           @map("received_by_id")
  isVerified         Boolean        @default(false) @map("is_verified")
  verifiedAt         DateTime?      @map("verified_at")
  submittedByStudent Boolean        @default(false) @map("submitted_by_student")
  createdAt          DateTime       @default(now()) @map("created_at")

  // Relationships
  feeStructure       FeeStructure   @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  student            StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  receivedBy         User?          @relation("ReceivedByMentor", fields: [receivedById], references: [id], onDelete: SetNull)

  @@map("fee_payments")
}

model Exam {
  id           Int        @id @default(autoincrement())
  title        String
  examType     String     @default("Unit Test") @map("exam_type") // Unit Test, Mid-Term, Pre-Board, Mock Test
  targetClass  Int        @map("target_class")
  subjectId    Int        @map("subject_id")
  examDate     DateTime   @map("exam_date")
  maxMarks     Float      @default(100.0) @map("max_marks")
  passingMarks Float      @default(33.0) @map("passing_marks")
  description  String?
  isPublished  Boolean    @default(true) @map("is_published")

  // Relationships
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  marks        ExamMark[]

  @@map("exams")
}

model ExamMark {
  id            Int            @id @default(autoincrement())
  examId        Int            @map("exam_id")
  studentId     Int            @map("student_id")
  marksObtained Float?         @map("marks_obtained")
  isAbsent      Boolean        @default(false) @map("is_absent")
  grade         String?
  remarks       String?

  // Relationships
  exam          Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId], name: "uq_exam_student")
  @@map("exam_marks")
}

model Timetable {
  id          Int      @id @default(autoincrement())
  targetClass Int      @map("target_class") // 10, 11, 12
  dayOfWeek   String   @map("day_of_week") // Monday - Saturday
  subjectId   Int      @map("subject_id")
  startTime   String   @map("start_time") // e.g. "16:00"
  endTime     String   @map("end_time") // e.g. "17:30"
  roomNo      String   @default("Classroom A") @map("room_no")
  mentorName  String   @default("Er. S. Negi") @map("mentor_name")
  mentorId    Int?     @map("mentor_id")

  // Relationships
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  mentor      User?    @relation("MentorTimetable", fields: [mentorId], references: [id], onDelete: SetNull)

  @@map("timetable")
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  targetClass String   @default("All") @map("target_class") // All, 10, 11, 12
  priority    String   @default("Normal") // Normal, Important, Urgent
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  isActive    Boolean  @default(true) @map("is_active")

  // Relationships
  createdBy   User?    @relation("CreatedAnnouncements", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("announcements")
}

model Homework {
  id           Int                     @id @default(autoincrement())
  title        String
  description  String
  targetClass  Int                     @map("target_class")
  subjectId    Int                     @map("subject_id")
  assignedDate DateTime                @default(now()) @map("assigned_date")
  dueDate      DateTime                @map("due_date")
  assignedById Int?                    @map("assigned_by_id")
  createdAt    DateTime                @default(now()) @map("created_at")

  // Relationships
  subject      Subject                 @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  assignedBy   User?                   @relation("AssignedHomeworks", fields: [assignedById], references: [id], onDelete: SetNull)
  statuses     StudentHomeworkStatus[]

  @@map("homework")
}

model StudentHomeworkStatus {
  id             Int            @id @default(autoincrement())
  homeworkId     Int            @map("homework_id")
  studentId      Int            @map("student_id")
  status         String         @default("Assigned") // Assigned, Completed, Late
  completionDate DateTime?      @map("completion_date")
  mentorFeedback String?        @map("mentor_feedback")

  // Relationships
  homework       Homework       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId], name: "uq_student_homework")
  @@map("student_homework_status")
}

model InstituteSettings {
  id           Int      @id @default(autoincrement())
  name         String   @default("NEGI TUTORIALS")
  tagline      String   @default("Learn • Grow • Succeed")
  phone        String   @default("+91 98765 43210")
  email        String   @default("contact@negitutorials.com")
  address      String   @default("Plot 12, Sector 4, Main Road, New Delhi, India")
  mailServer   String   @default("smtp.gmail.com") @map("mail_server")
  mailPort     Int      @default(587) @map("mail_port")
  mailUsername String?  @map("mail_username")
  mailPassword String?  @map("mail_password")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("institute_settings")
}

model Testimonial {
  id          Int      @id @default(autoincrement())
  studentName String   @map("student_name")
  scoreBadge  String   @map("score_badge") // e.g. "98.4% CBSE Class 12"
  batchInfo   String   @map("batch_info")  // e.g. "PCM Batch 2026"
  quote       String
  isFeatured  Boolean  @default(true) @map("is_featured")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("testimonials")
}
